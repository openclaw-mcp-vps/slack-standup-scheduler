# Cron endpoint protection (optional but recommended)
CRON_SECRET=replace-with-long-random-string

# App/runtime secrets
NEXTAUTH_SECRET=replace-with-long-random-string
PAYWALL_COOKIE_SECRET=replace-with-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
